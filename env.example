# Copy this file to .env and fill in the key.

# Groq API key (free): https://console.groq.com/keys
# GROQ_CLOUD_API_KEY is accepted as well.
GROQ_API_KEY=your_groq_api_key_here

# Optional settings and their defaults
# RA_CHAT_MODEL=openai/gpt-oss-120b       # any chat model your Groq account lists
# RA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RA_CHUNKING=sentence-512                 # see research_assistant/chunking.py; changing it re-indexes saved papers
# RA_RETRIEVAL=hybrid+rerank               # or dense, bm25, hybrid
# RA_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # BAAI/bge-reranker-base: more accurate, ~5x slower
# RA_CONTEXT_CHARS=15000                  # paper text sent per request; sized for the free tier's 8,000 tokens/minute
# RA_MAX_OUTPUT_TOKENS=1800
# RA_DATA_DIR=./data                      # where the library, index and profile are stored
